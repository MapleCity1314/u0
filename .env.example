# =============================================================================
# U0 Platform Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=
REDIS_URL=
REDIS_DEFAULT_TTL_SEC=30

# -----------------------------------------------------------------------------
# Fund NAV Service
# -----------------------------------------------------------------------------
FUND_NAV_DB_PATH=data/fund_nav.db
FUND_NAV_STORE_BACKEND=sqlite
FUND_NAV_INITIAL_INVITE_CODE=ILOVEW
FUND_NAV_INVITE_DEFAULT_USES=1
FUND_NAV_INVITE_MAX_USES=50
FUND_NAV_INVITE_TTL_SEC=604800
FUND_NAV_TOKEN_TTL_SEC=86400
FUND_NAV_CORS_ALLOW_ORIGINS=http://localhost:3000
FUND_NAV_MEDIA_DIR=data/media
FUND_NAV_MEDIA_BASE_PATH=/media
FUND_NAV_PUBLIC_BASE_URL=http://127.0.0.1:8000
FUND_NAV_ESTIMATE_TTL_SEC=10
FUND_NAV_CURVE_TTL_SEC=30
FUND_NAV_BG_REFRESH_ENABLED=false
FUND_NAV_BG_REFRESH_INTERVAL_SEC=20

# -----------------------------------------------------------------------------
# Agent Service - API Keys
# -----------------------------------------------------------------------------

# DeepSeek API (主模型 - deepseek-reasoner)
DEEPSEEK_API_KEY=

# Kimi / Moonshot API (子代理 & 备用模型 - kimi-latest / kimi-k2)
KIMI_API_KEY=

# OpenAI API (可选)
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=

# Anthropic API (可选)
ANTHROPIC_API_KEY=sk-xxx

# 搜索 API (可选)
TAVILY_API_KEY=tvly-xxx
SERPER_API_KEY=

# -----------------------------------------------------------------------------
# Agent Service - Main LLM Configuration
# 主模型: DeepSeek Reasoner (R1)
# -----------------------------------------------------------------------------
AGENT_LLM_PROVIDER=deepseek
AGENT_LLM_MODEL=deepseek-reasoner
AGENT_LLM_TEMPERATURE=0.7
AGENT_LLM_MAX_TOKENS=4096
AGENT_LLM_TIMEOUT=60
AGENT_LLM_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Agent Service - Fallback LLM Configuration
# 备用模型: Kimi (当主模型失败时降级)
# -----------------------------------------------------------------------------
AGENT_FALLBACK_LLM_ENABLED=true
AGENT_FALLBACK_LLM_PROVIDER=kimi
AGENT_FALLBACK_LLM_MODEL=kimi-latest
AGENT_FALLBACK_LLM_TEMPERATURE=0.7
AGENT_FALLBACK_LLM_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# Agent Service - SubAgent LLM Configuration
# 子代理模型: Kimi K2.5 (用于专项任务)
# -----------------------------------------------------------------------------
AGENT_SUBAGENT_LLM_PROVIDER=kimi
AGENT_SUBAGENT_LLM_MODEL=kimi-latest
AGENT_SUBAGENT_LLM_TEMPERATURE=0.7
AGENT_SUBAGENT_LLM_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# Agent Service - Feature Toggles
# -----------------------------------------------------------------------------
AGENT_ENABLE_WEB_SEARCH=true
AGENT_ENABLE_TOOLS=true
AGENT_ENABLE_SUB_AGENTS=true
AGENT_ENABLE_MEMORY=true
AGENT_STREAMING=true
AGENT_MAX_ITERATIONS=10
AGENT_MAX_TOOL_CALLS=20

# -----------------------------------------------------------------------------
# Agent Service - Search Configuration
# -----------------------------------------------------------------------------
AGENT_SEARCH_PROVIDER=tavily
AGENT_SEARCH_MAX_RESULTS=10
AGENT_SEARCH_SEARCH_DEPTH=basic

# -----------------------------------------------------------------------------
# Agent Service - MCP Configuration (Optional)
# -----------------------------------------------------------------------------
AGENT_MCP_ENABLED=true
AGENT_MCP_TRANSPORT=http
AGENT_MCP_HOST=127.0.0.1
AGENT_MCP_PORT=3001

# -----------------------------------------------------------------------------
# Agent Service - Memory Configuration
# -----------------------------------------------------------------------------
AGENT_MEMORY_TYPE=memory
AGENT_MEMORY_TTL_SEC=3600
AGENT_MEMORY_MAX_MESSAGES=100
